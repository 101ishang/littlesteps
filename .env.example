# Copy this file to .env (never commit .env itself — see Agents.md -> Secrets).

# Used to sign/verify login session tokens (JWT). Generate your own random value, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Portkey API key for model calls (see Agents.md -> Models), used by the
# explainer + safety-reviewer agent pair (backend/agents.py) that writes each
# check-in's plain-English explanation. Optional: if left blank, the app
# fails closed and shows fixed, non-AI explanation text instead — everything
# else (accounts, screening, history, growth charts) still works normally.
PORTKEY_API_KEY=

# Only used to build the password-reset link; safe to leave unset for local
# dev (defaults to http://localhost:5173). Set this to your real deployed URL
# if hosting online — see README.md -> Deploying.
FRONTEND_URL=
